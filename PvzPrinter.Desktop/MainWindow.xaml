<Window x:Class="PvzPrinter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PvzPrinter" 
        MinHeight="380" MinWidth="350"
        Height="420" Width="400"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        Closing="OnWindowClosing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Информация -->
            <RowDefinition Height="*"/>
            <!-- Кнопки (растягивается) -->
            <RowDefinition Height="Auto"/>
            <!-- Футер -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,15">
            <Image Source="logo.png" Height="32" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="PvzPrinter" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Информация о программе -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock Text="Печать номеров ячеек для ПВЗ" FontSize="14" 
                       HorizontalAlignment="Center" Foreground="Gray"/>
            <TextBlock Text="Версия 1.0" FontSize="12" Margin="0,5,0,0"
                       HorizontalAlignment="Center" Foreground="Gray"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button Content="🌐 О программе" MinWidth="200" Height="35" Margin="0,5"
            Click="OnWebsiteClick"/>
            <Button Content="❤️ Отблагодарить" MinWidth="200" Height="35" Margin="0,5"
            Click="OnDonateClick"/>
            <Button Content="⚙️ Настройки" MinWidth="200" Height="35" Margin="0,5"
            Click="OnSettingsClick"/>
            <Button Content="📄 log-файл" MinWidth="200" Height="35" Margin="0,5"
            Click="OnOpenLogClick"/>
        </StackPanel>

        <!-- Футер -->
        <TextBlock Grid.Row="3" Text="Работает в фоновом режиме через трей" 
                   FontSize="11" Foreground="Gray" HorizontalAlignment="Center" Margin="0,10,0,0"/>
    </Grid>
</Window>